  events    SubscriptionEvent[] @relation("SubscriptionEventSubscription")

  @@index([trainerId, isCurrent])
  @@map("subscriptions")
  @@schema("personalhub")
}

model SubscriptionEvent {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @map("subscription_event_id") @db.Uuid
