  @@map("subscription_events")
  @@schema("personalhub")
}

model AuditEvent {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @map("operation_id") @db.Uuid
  actorType              String              @map("actor_type")
  actorRef               String              @map("actor_ref")
