}

model SubscriptionPlan {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @map("subscription_plan_id") @db.Uuid
  offerCode      String            @map("offer_code")
  version        Int
  code           String
  billingPeriod  String            @map("billing_period")
  status         String            @default("DRAFT")
  canonicalFree  Boolean           @default(false) @map("canonical_free")
  priceCents     Int               @map("price_cents")
