model Appointment {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @map("appointment_id") @db.Uuid
  trainerId      String               @map("trainer_id") @db.Uuid
  studentId      String               @map("student_id") @db.Uuid
  linkId         String               @map("link_id") @db.Uuid
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(3)
  timezone       String
  status         String               @default("SCHEDULED")
  statusReason   String?              @map("status_reason")
  recordRevision Int                  @default(1) @map("record_revision")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  trainer        TrainerProfile       @relation("AppointmentTrainer", fields: [trainerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student        StudentProfile       @relation("AppointmentStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  link           TrainerStudentLink   @relation("AppointmentLink", fields: [linkId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events         AppointmentEvent[]   @relation("AppointmentEventAppointment")
  disputes       AppointmentDispute[] @relation("AppointmentDisputeAppointment")

  @@unique([id, studentId])
  @@index([linkId, status, startsAt])
  @@map("appointments")
  @@schema("personalhub")
}

model AppointmentEvent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @map("appointment_event_id") @db.Uuid
  appointmentId  String      @map("appointment_id") @db.Uuid
  sequence       Int
  operationId    String      @map("operation_id") @db.Uuid
  eventType      String      @map("event_type")
  previousStatus String?     @map("previous_status")
  newStatus      String      @map("new_status")
  reason         String?
  details        Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment    Appointment @relation("AppointmentEventAppointment", fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      AuditEvent  @relation("AppointmentEventOperation", fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([appointmentId, sequence])
  @@map("appointment_events")
  @@schema("personalhub")
}

model AppointmentDispute {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @map("dispute_id") @db.Uuid
  appointmentId      String         @map("appointment_id") @db.Uuid
  studentId          String         @map("student_id") @db.Uuid
  status             String         @default("OPEN")
  claim              String
  assignedActorRef   String?        @map("assigned_actor_ref")
  resolvedByActorRef String?        @map("resolved_by_actor_ref")
  resolutionCode     String?        @map("resolution_code")
  resolutionReason   String?        @map("resolution_reason")
  openedAt           DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz(3)
