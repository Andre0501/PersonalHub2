{
  "name": "personalhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <27"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "build": "npm run db:generate && tsc -p tsconfig.server.json && tsc -p apps/web/tsconfig.json && vite build apps/web",
    "start": "node --env-file-if-exists=.env build/apps/api/src/main.js",
    "web": "vite apps/web",
    "test": "npm run build && node --test --test-concurrency=1 tests/integration.test.mjs",
    "demo": "npm run build && node scripts/run-demo.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs",
    "contract": "tsc -p tsconfig.server.json && node scripts/openapi.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.0",
    "embedded-postgres": "18.7.0-beta.19",
    "pg": "^8.16.0",
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "playwright-core": "^1.55.0"
  }
}
